# Vercel injects most of these automatically when connecting Neon, Supabase, and Upstash.
# Leave blank for zero-config fallback to static verified seeds and in-memory caches.

# Neon Postgres (Storage -> Neon on Vercel)
DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Supabase Auth (Marketplace -> Supabase on Vercel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Upstash Redis / Vercel KV Rate Limiting (Optional)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Manual Secrets (Required for production governance and cron execution)
# Generate a random 32+ char token (e.g. openssl rand -hex 32)
ADMIN_TOKEN=
CRON_SECRET=

# Optional data.gov.in / RBI API key
DATA_GOV_API_KEY=
