{
  "crons": [
    {
      "path": "/api/cron/mf-refresh",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/macro-refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/fd-verify",
      "schedule": "0 2 * * 1"
    },
